pipeline {
    agent any
    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage('Build set demonstration image') {
            steps {
                powershell './scripts/Build-SetImage.ps1 -SetNumber 9'
                script {
                    def imageNote = "Image k8s-set-09:build-${env.BUILD_NUMBER}; namespace k8s-set-09"
                    currentBuild.description = [currentBuild.description, imageNote].findAll { it }.join(' | ')
                }
            }
        }
        stage('Prepare namespace') {
            steps {
                bat 'kubectl --context docker-desktop apply -f sets/set-09/namespace.yaml'
            }
        }
        stage('Create PVC and mount in Pod') {
            steps {
                bat 'kubectl --context docker-desktop get storageclass'
                bat 'kubectl --context docker-desktop apply -f sets/set-09/pvc.yaml'
                bat 'kubectl --context docker-desktop apply -f sets/set-09/pod.yaml'
                bat 'kubectl --context docker-desktop -n k8s-set-09 wait --for=condition=Ready pod/pvc-demo --timeout=180s'
            }
        }
        stage('Write persistent data') {
            steps {
                bat 'kubectl --context docker-desktop -n k8s-set-09 exec pvc-demo -- sh -c "echo stored-through-jenkins > /data/proof.txt"'
                bat 'kubectl --context docker-desktop -n k8s-set-09 exec pvc-demo -- cat /data/proof.txt'
                bat 'kubectl --context docker-desktop -n k8s-set-09 get pvc lab-storage'
            }
        }
        stage('Verify data survives Pod replacement') {
            steps {
                bat 'kubectl --context docker-desktop -n k8s-set-09 delete pod pvc-demo --wait=true'
                bat 'kubectl --context docker-desktop apply -f sets/set-09/pod.yaml'
                bat 'kubectl --context docker-desktop -n k8s-set-09 wait --for=condition=Ready pod/pvc-demo --timeout=180s'
                bat 'kubectl --context docker-desktop -n k8s-set-09 exec pvc-demo -- grep -Fx stored-through-jenkins /data/proof.txt'
            }
        }
        stage('Show this build in Kubernetes') {
            steps {
                powershell './scripts/Deploy-SetImage.ps1 -SetNumber 9'
                archiveArtifacts artifacts: 'set-image-evidence/*', fingerprint: true
            }
        }
    }
}
