pipeline {
    agent any
    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage('Build set demonstration image') {
            steps {
                powershell './scripts/Build-SetImage.ps1 -SetNumber 1'
                script {
                    def imageNote = "Image k8s-set-01:build-${env.BUILD_NUMBER}; namespace k8s-set-01"
                    currentBuild.description = [currentBuild.description, imageNote].findAll { it }.join(' | ')
                }
            }
        }
        stage('Prepare namespace') {
            steps {
                bat 'kubectl --context docker-desktop apply -f sets/set-01/namespace.yaml'
            }
        }
        stage('Verify Kubernetes connection') {
            steps {
                bat 'kubectl --context docker-desktop cluster-info'
                bat 'kubectl --context docker-desktop get nodes -o wide'
                bat 'kubectl --context docker-desktop -n k8s-set-01 auth can-i create deployments'
                bat 'kubectl --context docker-desktop -n k8s-set-01 get pods'
            }
        }
        stage('Show this build in Kubernetes') {
            steps {
                powershell './scripts/Deploy-SetImage.ps1 -SetNumber 1'
                archiveArtifacts artifacts: 'set-image-evidence/*', fingerprint: true
            }
        }
    }
}
