pipeline {
    agent any
    options { timeout(time: 10, unit: 'MINUTES'); timestamps(); disableConcurrentBuilds() }
    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://github.com/Ayaan-1082/simple-java-app.git', description: 'GitHub HTTPS URL of your copy of this lab repository')
        string(name: 'BRANCH', defaultValue: 'kubernetes-practical', description: 'Git branch to deploy')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: '', description: 'Jenkins Git credential ID; empty for a public repository')
    }
    triggers { pollSCM('H/2 * * * *'); githubPush() }
    stages {
        stage('Require GitHub repository') {
            steps {
                script {
                    if (!params.REPO_URL.trim()) {
                        currentBuild.description = 'NOT RUN: GitHub repository required'
                        error('Set REPO_URL to your GitHub repository. GitHub integration has not been verified.')
                    }
                    if (!(params.REPO_URL ==~ /^https:\/\/github\.com\/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(?:\.git)?\/?$/)) {
                        error('Use an HTTPS github.com repository URL.')
                    }
                }
            }
        }
        stage('Checkout GitHub') {
            steps {
                git branch: params.BRANCH, credentialsId: params.GIT_CREDENTIALS_ID.trim(), url: params.REPO_URL.trim()
                bat 'git log -1 --format="%%H %%s"'
            }
        }
        stage('Deploy checked out page and manifest') {
            steps {
                bat 'kubectl --context docker-desktop apply -f sets/set-11/namespace.yaml'
                powershell '''
                    $ErrorActionPreference = 'Stop'
                    $configMap = & kubectl --context docker-desktop -n k8s-set-11 create configmap github-page --from-file=index.html=sets/set-11/index.html --dry-run=client -o yaml
                    if ($LASTEXITCODE -ne 0) { throw 'Could not generate the page ConfigMap.' }
                    $configMap | & kubectl --context docker-desktop -n k8s-set-11 apply -f -
                    if ($LASTEXITCODE -ne 0) { throw 'Could not apply the page ConfigMap.' }
                '''
                bat 'kubectl --context docker-desktop apply -f sets/set-11/deployment.yaml'
                bat 'kubectl --context docker-desktop -n k8s-set-11 rollout restart deployment/github-web'
                bat 'kubectl --context docker-desktop -n k8s-set-11 rollout status deployment/github-web --timeout=180s'
                bat 'kubectl --context docker-desktop -n k8s-set-11 get deployment,pods,service -o wide'
                bat 'kubectl --context docker-desktop -n k8s-set-11 exec deployment/github-web -- wget -qO- http://github-web'
            }
        }
    }
}
