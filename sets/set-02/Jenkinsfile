pipeline {
    agent any
    options {
        timeout(time: 10, unit: 'MINUTES')
        timestamps()
        disableConcurrentBuilds()
    }
    stages {
        stage('Build set demonstration image') {
            steps {
                powershell './scripts/Build-SetImage.ps1 -SetNumber 2'
                script {
                    def imageNote = "Image k8s-set-02:build-${env.BUILD_NUMBER}; namespace k8s-set-02"
                    currentBuild.description = [currentBuild.description, imageNote].findAll { it }.join(' | ')
                }
            }
        }
        stage('Prepare namespace') {
            steps {
                bat 'kubectl --context docker-desktop apply -f sets/set-02/namespace.yaml'
            }
        }
        stage('Deploy sample application') {
            steps {
                bat 'kubectl --context docker-desktop apply -f sets/set-02/deployment.yaml'
                bat 'kubectl --context docker-desktop apply -f sets/set-02/service.yaml'
            }
        }
        stage('Wait and verify') {
            steps {
                bat 'kubectl --context docker-desktop -n k8s-set-02 rollout status deployment/web --timeout=180s'
                bat 'kubectl --context docker-desktop -n k8s-set-02 get deployment,pods,service -o wide'
                bat 'kubectl --context docker-desktop -n k8s-set-02 exec deployment/web -- wget -qO- http://web'
            }
        }
        stage('Show this build in Kubernetes') {
            steps {
                powershell './scripts/Deploy-SetImage.ps1 -SetNumber 2'
                archiveArtifacts artifacts: 'set-image-evidence/*', fingerprint: true
            }
        }
    }
}
